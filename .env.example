# ── Dataset ───────────────────────────────────────────────────────────────────
# Absolute or relative path to a local creditcard.csv.
# Leave empty to download automatically via kagglehub.
DATASET_PATH=

# Kaggle dataset identifier used by kagglehub when DATASET_PATH is not set.
KAGGLE_DATASET_SLUG=mlg-ulb/creditcardfraud

# ── Output ────────────────────────────────────────────────────────────────────
# Directory where charts and reports are written.
OUTPUT_DIR=outputs

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Reproducibility ───────────────────────────────────────────────────────────
RANDOM_SEED=42
